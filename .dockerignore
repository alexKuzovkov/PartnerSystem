# Build outputs (most important: prevents duplicate AssemblyInfo artifacts)
**/bin/
**/obj/

# IDE
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Git
.git/
.gitignore

# Docker files (not needed inside the container image)
**/Dockerfile
**/.dockerignore
docker-compose*.yml

# Tests (not needed in production images)
tests/

# Documentation
*.md
docs/
README.md

# Logs
**/*.log
**/logs/

# Node modules (if present)
**/node_modules/

# Launch settings (local development settings)
**/Properties/launchSettings.json

# Temp files
**/Thumbs.db
**/.DS_Store
# Local secrets and environment overrides
.env
.env.*
!.env.example
