<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsWebProject>true</IsWebProject>
	</PropertyGroup>

	<ItemGroup Condition="'$(IsWebProject)' == 'true'">
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
		<PackageReference Include="AspNetCore.HealthChecks.Redis" />
		<PackageReference Include="RedLock.net" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Shared\PartnerSystem.Contracts\PartnerSystem.Contracts.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="..\Shared\PartnerSystem.Contracts\PartnerService.proto" GrpcServices="Client" Link="Protos\PartnerService.proto" />
	</ItemGroup>
	
</Project>
